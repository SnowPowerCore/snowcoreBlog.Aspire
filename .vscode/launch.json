{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C#: snowcoreBlog.Aspire [https]",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}\\snowcoreBlog.Aspire.csproj",
            "serverReadyAction": {
                "pattern": "(https://\\S+/login\\?t=[0-9a-zA-Z]+)",
                "uriFormat": "%s",
                "action": "openIntegratedBrowser",
                "killOnServerStop": false
            }
        },
        {
            "name": "Launch Blazor WASM (Watch + Integrated Browser)",
            "type": "blazor-wasm",
            "request": "launch",
            "project": "${workspaceFolder}\\snowcoreBlog.Frontend\\snowcoreBlog.Frontend.WasmForDebugging", // project dir or .csproj; default: workspace folder
            "watch": true,                                // dotnet watch (Hot Reload); false = plain dotnet run
            "readyTimeoutMs": 75000,                      // full-readiness gate timeout
            "strictHttpOk": false,                        // true = require final status < 400
            "openBrowser": true,                          // false = only run + gate, no browser session
            "logLevel": "debug",                          // output-channel verbosity
            "logFile": false                              // also log to .vscode/blazor-wasm-debug.log
        },
        {
            "name": "Watch: snowcoreBlog.Frontend.WasmForDebugging",
            "type": "coreclr",
            "request": "launch",
            "cwd": "${workspaceFolder}\\snowcoreBlog.Frontend\\snowcoreBlog.Frontend.WasmForDebugging",
            "program": "dotnet",
            "args": [
                "watch",
                "--project",
                ".",
                "--verbose"
            ],
            "preLaunchTask": "build"
        },
        {
            "name": "Attach: snowcoreBlog.Frontend.WasmForDebugging",
            "type": "blazorwasm",
            "request": "attach",
            "cwd": "${workspaceFolder}\\snowcoreBlog.Frontend\\snowcoreBlog.Frontend.WasmForDebugging",
            "browser": "edge",
            "url": "https://localhost:7288",
            "timeout": 75000
        }
    ],
    "compounds": [
        {
            "name": "Start with Hot Reload: snowcoreBlog.Frontend.WasmForDebugging",
            "configurations": [
                "Watch: snowcoreBlog.Frontend.WasmForDebugging",
                "Attach: snowcoreBlog.Frontend.WasmForDebugging"
            ]
        }
    ]
}