<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>snowcore's Blog — Admin</title>
    <base href="@(HttpContext.Request.PathBase.Value + "/")" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["snowcoreBlog.AdminFrontend.Host.styles.css"]" />
    <HeadOutlet />
</head>

<body>
    @* Admin pages call the backend through server-side Apizr managers — the app is pinned to InteractiveServer so
       the WebAssembly bundle never takes over interactive circuits. *@
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js" type="text/javascript"></script>
    <script
        src="_content/Microsoft.FluentUI.AspNetCore.Components/Microsoft.FluentUI.AspNetCore.Components.lib.module.js"
        type="module" async></script>
    <script src="_content/Microsoft.FluentUI.AspNetCore.Components/js/loading-theme.js" type="text/javascript"></script>
    <loading-theme storage-name="admin-theme"></loading-theme>
</body>

</html>

@code
{
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;
}
